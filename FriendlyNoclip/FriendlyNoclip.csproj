<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>FriendlyNoclip</AssemblyName>
    <RootNamespace>Unnamed42.FriendlyNoclip</RootNamespace>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <OutputType>Library</OutputType>
    <Deterministic>true</Deterministic>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- ★ 必须显式声明 x64。不写就是 AnyCPU，Roslyn 把 PE 头写成
         Machine=i386 + OptionalMagic=PE32。

         对于**纯托管**程序集，这个字段只是提示，CLR 不据此拒绝加载 ——
         所以它本身不造成故障。但本项目**全程是 64 位假设**：
         StaticVaToRuntime 里的 0x180000000、一堆 IntPtr 尺寸相关的原生
         读取，在 32 位宿主下全部溢出。AnyCPU 给了这份代码一个**假的**
         「可移植」外观。
         声明 x64 → 构建期就把错误暴露出来，而不是运行时才崩。

         （附带：产物变成 Machine=x86-64 + PE32+，KDE Dolphin 的归类
           也跟着正常。那是结果，不是目的。） -->
    <PlatformTarget>x64</PlatformTarget>
    <!-- ⚠️ 不要往 Version / InformationalVersion / AssemblyMetadata 里塞构建时刻。
         它们都会变成 [assembly: ...] 特性，也就是**程序集内容**；
         内容一含时间，<Deterministic>true</Deterministic> 就形同虚设 ——
         同一份源码连续构建两次 checksum 不同，
         使「部署后核对 md5 一致」这一步永远失败。
         （已实测：InformationalVersion 与 AssemblyMetadata 都会导致此问题。）

         Deterministic 只保证「**相同输入** → 逐字节相同输出」，
         它不会、也不可能把输入里的时间戳抹掉。
         （它自 .NET SDK 起默认就是 true，写出来只为自文档化。）

         曾有个 BuildStamp（时刻）属性就是因为上述原因被移除的 ——
         「跑的是不是新产物」改为靠**部署后核对 md5**：
         Deterministic 生效后 md5 是稳定的，这才是可靠的判据。
         启动日志也会打印自身 md5（见 Plugin.cs），可直接对账。 -->
    <Version>1.0.0</Version>
    <Authors>unnamed42</Authors>
    <Description>移动时允许穿越友方和城防</Description>

    <GameDir>..\gamedir</GameDir>
    <Il2cppDir>..\gamedir\MelonLoader\Il2CppAssemblies</Il2cppDir>
    <MelonLoaderDir>..\gamedir\MelonLoader\net6</MelonLoaderDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="MelonLoader">
      <HintPath>$(MelonLoaderDir)\MelonLoader.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(MelonLoaderDir)\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- Iced：x86/x64 汇编器 + 反汇编器。MelonLoader 自带（net6/Iced.dll，1.9MB），
         运行时一定已加载，所以 <Private>False</Private> —— 不拷进输出、不需要 ILRepack。 -->
    <Reference Include="Iced">
      <HintPath>$(MelonLoaderDir)\Iced.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(MelonLoaderDir)\Il2CppInterop.Runtime.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(Il2cppDir)\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(Il2cppDir)\Il2Cppmscorlib.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Il2CppSystem">
      <HintPath>$(Il2cppDir)\Il2CppSystem.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Il2CppSystem.Core">
      <HintPath>$(Il2cppDir)\Il2CppSystem.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(Il2cppDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(Il2cppDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(Il2cppDir)\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="MelonLoader.MelonInfo">
      <_Parameter1>Unnamed42.FriendlyNoclip.Plugin</_Parameter1>
      <_Parameter1_TypeName>System.Type</_Parameter1_TypeName>
      <_Parameter2>$(Description)</_Parameter2>
      <_Parameter3>$(Version)</_Parameter3>
      <_Parameter4>$(Authors)</_Parameter4>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
