# Build outputs
bin/
obj/
*.dll
*.pdb
*.exe

# Build inputs that ARE vendored and must be committed:
# mcs.dll (Mono.CSharp) is embedded into the mod by ILRepack. MelonLoader does not ship it, so
# without this exception a fresh clone cannot build. Undo the *.dll rule for this one path.
!lib/net6/mcs.dll

# IDE
.vs/
.vscode/
*.user
*.suo
*.sln.docstates

# OS
.DS_Store
Thumbs.db

# Package caches
packages/
*.nupkg

# Logs
*.log

# Game-specific knowledge (contains user data)
game_knowledge/

# Local build/deploy scratch
dist/
.nuget/
ILRepack.List

# gamedir is a symlink to the game install; an absolute machine-specific path that must never be
# committed. Builds resolve it relative to the repo root.
gamedir
